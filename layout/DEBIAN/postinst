#!/bin/sh

# Copy prefs to PreferenceLoader path where it looks on rootless
mkdir -p "/var/jb/Library/PreferenceLoader/Preferences/SnowingCatsPrefs"
cp -r "/var/jb/Library/PreferenceBundles/SnowingCatsPrefs.bundle/"* "/var/jb/Library/PreferenceLoader/Preferences/SnowingCatsPrefs/"

# Also create symlink as fallback
ln -sf "/var/jb/Library/PreferenceBundles/SnowingCatsPrefs.bundle" "/var/jb/Library/PreferenceLoader/Preferences/SnowingCatsPrefs.bundle"

exit 0
